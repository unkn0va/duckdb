# name: test/sql/optimizer/prenest/prenest_explain_plan.test
# description: The plan shows which lists the reader pre-filters, and EXPLAIN decides like the query
# group: [prenest]

# Two things are pinned here.
#
# 1. EXPLAIN <query> now makes the same extraction decision as <query>. SafeToTruncate asks the
#    plan's own output whether it reads the target list or a value containing it; under EXPLAIN
#    the root is a LogicalExplain, which does not override GetColumnBindings, so the default
#    handed back the synthetic ColumnBinding(0, 0). That resolved - via FindDefiningOperator(0) -
#    to whichever scan happened to hold table index 0, and its first column looked like an
#    ancestor of the target, so every pushdown was refused under EXPLAIN. The check now skips
#    statement-level wrappers and asks the operator that really produces the result.
#
# 2. `Pre-nest Filters` on the scan node reports the list path and the predicate, which is what
#    makes these assertions possible at all. This complements the counters rather than repeating
#    them: parquet_prenest_stat looks inside the reader, the plan shows the optimizer's decision.

require parquet

statement ok
PRAGMA enable_verification

statement ok
COPY (
    SELECT i AS cid,
           [{'oid': i * 10 + k,
             'items': [{'qty': (i + k + j) % 5, 'price': j * 100} FOR j IN range(3)]}
            FOR k IN range(2)] AS orders
    FROM range(6) t(i)
) TO '__TEST_DIR__/prenest_explain_plan.parquet' (FORMAT parquet)

# ------------------------------------------------------------------------------------------------
# the q6 shape: a predicate on the innermost list, nothing else reading it
# ------------------------------------------------------------------------------------------------

statement ok
SET parquet_prenest_auto=true

# the spec reaches the scan, and the plan names the list by its full path
query II
EXPLAIN SELECT count(*) FROM (
    SELECT unnest(o.items) AS l
    FROM (SELECT unnest(orders) AS o FROM '__TEST_DIR__/prenest_explain_plan.parquet') os
) WHERE l.qty < 3
----
physical_plan	<REGEX>:.*Pre-nest Filters.*orders\[\]\.items.*

# ... and the predicate itself is shown, not just the list
query II
EXPLAIN SELECT count(*) FROM (
    SELECT unnest(o.items) AS l
    FROM (SELECT unnest(orders) AS o FROM '__TEST_DIR__/prenest_explain_plan.parquet') os
) WHERE l.qty < 3
----
physical_plan	<REGEX>:.*qty.*

# with the pass off there is nothing on the scan
statement ok
SET parquet_prenest_auto=false

query II
EXPLAIN SELECT count(*) FROM (
    SELECT unnest(o.items) AS l
    FROM (SELECT unnest(orders) AS o FROM '__TEST_DIR__/prenest_explain_plan.parquet') os
) WHERE l.qty < 3
----
physical_plan	<!REGEX>:.*Pre-nest Filters.*

# ------------------------------------------------------------------------------------------------
# the safety counterexamples: the target list is also read whole, so nothing may be pushed.
# Before the wrapper fix these passed for the wrong reason - EXPLAIN refused everything.
# ------------------------------------------------------------------------------------------------

statement ok
SET parquet_prenest_auto=true

# two-level: the inner list is read whole by len()
query II
EXPLAIN SELECT sum(len(o.items)), count(*) FROM (
    SELECT o, unnest(o.items) AS l
    FROM (SELECT unnest(orders) AS o FROM '__TEST_DIR__/prenest_explain_plan.parquet') os
) WHERE l.qty < 3
----
physical_plan	<!REGEX>:.*Pre-nest Filters.*

# one-level: the outer list is read whole, and it contains the inner one
query II
EXPLAIN SELECT sum(len(orders)), count(*) FROM (
    SELECT orders, unnest(orders) AS o FROM '__TEST_DIR__/prenest_explain_plan.parquet'
) WHERE o.oid < 30
----
physical_plan	<!REGEX>:.*Pre-nest Filters.*

# output-only: the enclosing element reaches the result, where no expression reads it
query II
EXPLAIN SELECT o FROM (
    SELECT o, unnest(o.items) AS l
    FROM (SELECT unnest(orders) AS o FROM '__TEST_DIR__/prenest_explain_plan.parquet') os
) WHERE l.qty < 3
----
physical_plan	<!REGEX>:.*Pre-nest Filters.*

# the q22 shape: the list is read with no UNNEST at all
query II
EXPLAIN SELECT count(*) FROM '__TEST_DIR__/prenest_explain_plan.parquet' WHERE len(orders) = 0
----
physical_plan	<!REGEX>:.*Pre-nest Filters.*

# ------------------------------------------------------------------------------------------------
# EXPLAIN and the bare query agree - the point of the wrapper fix. The counter is what the reader
# did; the plan above is what the optimizer decided. They have to say the same thing.
# ------------------------------------------------------------------------------------------------

statement ok
PRAGMA disable_verification

statement ok
SELECT parquet_prenest_stat('reset')

statement ok
SELECT count(*) FROM (
    SELECT unnest(o.items) AS l
    FROM (SELECT unnest(orders) AS o FROM '__TEST_DIR__/prenest_explain_plan.parquet') os
) WHERE l.qty < 3

# 36 elements, 23 pass - the plan said it would push, and the reader did
query I
SELECT parquet_prenest_stat('elements_appended')
----
23

statement ok
SELECT parquet_prenest_stat('reset')

statement ok
SELECT sum(len(o.items)), count(*) FROM (
    SELECT o, unnest(o.items) AS l
    FROM (SELECT unnest(orders) AS o FROM '__TEST_DIR__/prenest_explain_plan.parquet') os
) WHERE l.qty < 3

# the plan showed no spec, and nothing was dropped
query I
SELECT parquet_prenest_stat('elements_appended')
----
0

# ------------------------------------------------------------------------------------------------
# Statement wrappers must not change the decision. This is the same bug as the EXPLAIN one above,
# not a separate one: LogicalOperator::GetColumnBindings() DEFAULTS to {ColumnBinding(0, 0)}, so
# any statement-level operator that does not override it hands SafeToTruncate a binding that
# belongs to nobody. It then resolved, via table index 0, to whichever scan held that index and
# looked like an ancestor of the target list.
#
# CREATE TABLE AS and COPY (...) TO were losing the pushdown outright - measured elements_appended
# 0 against the bare query's 23 - so this is a regression test for real statements, not only for
# EXPLAIN. For those two forms descending to the child is also the semantically right question:
# the wrapped query's output is what gets written, so the child's bindings are exactly what has
# to stay observable.
#
# Both halves are asserted. The counter says the reader dropped elements; the content says it
# dropped the RIGHT ones.
# ------------------------------------------------------------------------------------------------

statement ok
SET parquet_prenest_auto=true

# --- reference: the bare query ---

statement ok
SELECT parquet_prenest_stat('reset')

query III
SELECT count(*) AS n, sum(l.qty) AS sq, sum(l.price) AS sp FROM (
    SELECT unnest(o.items) AS l
    FROM (SELECT unnest(orders) AS o FROM '__TEST_DIR__/prenest_explain_plan.parquet') os
) WHERE l.qty < 3
----
23	24	2200

query I
SELECT parquet_prenest_stat('elements_appended')
----
23

# --- CREATE TABLE AS ---

statement ok
SELECT parquet_prenest_stat('reset')

statement ok
CREATE TABLE ctas_result AS
SELECT count(*) AS n, sum(l.qty) AS sq, sum(l.price) AS sp FROM (
    SELECT unnest(o.items) AS l
    FROM (SELECT unnest(orders) AS o FROM '__TEST_DIR__/prenest_explain_plan.parquet') os
) WHERE l.qty < 3

# was 0 before the wrapper fix
query I
SELECT parquet_prenest_stat('elements_appended')
----
23

query III
SELECT n, sq, sp FROM ctas_result
----
23	24	2200

# --- COPY (...) TO ---

statement ok
SELECT parquet_prenest_stat('reset')

statement ok
COPY (
    SELECT count(*) AS n, sum(l.qty) AS sq, sum(l.price) AS sp FROM (
        SELECT unnest(o.items) AS l
        FROM (SELECT unnest(orders) AS o FROM '__TEST_DIR__/prenest_explain_plan.parquet') os
    ) WHERE l.qty < 3
) TO '__TEST_DIR__/prenest_wrapper_out.parquet' (FORMAT parquet)

# was 0 before the wrapper fix
query I
SELECT parquet_prenest_stat('elements_appended')
----
23

# the written file carries the same answer. HUGEINT has no parquet type, so the sums come back
# as a wider numeric - cast before comparing rather than pinning the round-trip spelling.
query III
SELECT n, sq::BIGINT, sp::BIGINT FROM '__TEST_DIR__/prenest_wrapper_out.parquet'
----
23	24	2200

# --- INSERT INTO ... SELECT ---
# This form already worked, and is here so that a future change to the wrapper list cannot
# silently make the four disagree.

statement ok
CREATE TABLE insert_result AS SELECT * FROM ctas_result WHERE false

statement ok
SELECT parquet_prenest_stat('reset')

statement ok
INSERT INTO insert_result
SELECT * FROM (
    SELECT count(*) AS n, sum(l.qty) AS sq, sum(l.price) AS sp FROM (
        SELECT unnest(o.items) AS l
        FROM (SELECT unnest(orders) AS o FROM '__TEST_DIR__/prenest_explain_plan.parquet') os
    ) WHERE l.qty < 3
)

query I
SELECT parquet_prenest_stat('elements_appended')
----
23

query III
SELECT n, sq, sp FROM insert_result
----
23	24	2200
