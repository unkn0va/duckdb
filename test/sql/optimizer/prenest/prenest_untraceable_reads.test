# ------------------------------------------------------------------------------------------------
# p5 - reading the list above a window operator
# A window passes its input columns through under the child's bindings, so this one resolves
# and is caught the ordinary way - it is here to pin that it is NOT collateral of the fix.
# ------------------------------------------------------------------------------------------------

statement ok
SET parquet_prenest_auto=false

statement ok
CREATE TABLE p5_off AS SELECT sum(len(w.o.items)) AS t, count(*) AS n
FROM (SELECT o, row_number() OVER (ORDER BY o.oid) AS rn FROM (
    SELECT o FROM (SELECT o, unnest(o.items) AS l
              FROM (SELECT unnest(orders) AS o FROM '__TEST_DIR__/prenest_untraceable.parquet') os)
WHERE l.qty < 3
) b) w

statement ok
SET parquet_prenest_auto=true

statement ok
SELECT parquet_prenest_stat('reset')

statement ok
CREATE TABLE p5_on AS SELECT sum(len(w.o.items)) AS t, count(*) AS n
FROM (SELECT o, row_number() OVER (ORDER BY o.oid) AS rn FROM (
    SELECT o FROM (SELECT o, unnest(o.items) AS l
              FROM (SELECT unnest(orders) AS o FROM '__TEST_DIR__/prenest_untraceable.parquet') os)
WHERE l.qty < 3
) b) w

query II
SELECT (SELECT count(*) FROM (SELECT * FROM p5_on EXCEPT ALL SELECT * FROM p5_off)),
       (SELECT count(*) FROM (SELECT * FROM p5_off EXCEPT ALL SELECT * FROM p5_on))
----
0	0

query I
SELECT parquet_prenest_stat('elements_appended:items')
----
0

query I
SELECT parquet_prenest_lists() = ''
----
true
