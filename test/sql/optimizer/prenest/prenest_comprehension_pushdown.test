# name: test/sql/optimizer/prenest/prenest_comprehension_pushdown.test
# description: Nested filter pushdown (shallow) must not change any result
# group: [prenest]

# Revived from test/optimizer/pushdown/pushdown_unnest_element_filter.test, removed in
# fff6e6276e. The EXPLAIN assertions of that file specified a different design (predicates
# absorbed into the UNNEST operator and REMOVED from the Filter above it) and are not
# revived - this port leaves the Filter in place on purpose. Every result assertion is
# kept: they are invariants that hold whatever the optimizer does with the predicate.

require parquet

statement ok
PRAGMA enable_verification

statement ok
SET parquet_prenest_auto=true

statement ok
CREATE TABLE orders_tbl AS
SELECT i AS cid,
       CASE WHEN i % 7 = 0 THEN NULL
            WHEN i % 5 = 0 THEN []::STRUCT(oid BIGINT, qty BIGINT, tag VARCHAR)[]
            ELSE [{'oid': i * 100 + j, 'qty': (i + j) % 4, 'tag': 'tag' || (j % 3)::VARCHAR}
                  FOR j IN range(1 + i % 3)]
       END AS orders
FROM range(40) s(i);

query III
SELECT cid, o.oid, o.qty FROM (SELECT cid, UNNEST(orders) AS o FROM orders_tbl)
WHERE o.qty >= 3 ORDER BY ALL;
----
2	201	3
3	300	3
11	1100	3
17	1702	3
19	1900	3
22	2201	3
23	2300	3
26	2601	3
27	2700	3
29	2902	3
31	3100	3
34	3401	3
38	3801	3
39	3900	3

# several conjuncts
query III
SELECT cid, o.oid, o.qty FROM (SELECT cid, UNNEST(orders) AS o FROM orders_tbl)
WHERE o.qty >= 1 AND o.tag = 'tag0' ORDER BY ALL;
----
1	100	1
2	200	2
3	300	3
6	600	2
9	900	1
11	1100	3
13	1300	1
17	1700	1
18	1800	2
19	1900	3
22	2200	2
23	2300	3
26	2600	2
27	2700	3
29	2900	1
31	3100	3
33	3300	1
34	3400	2
37	3700	1
38	3800	2
39	3900	3

# a disjunction is not expressible as a pre-nest condition - the result must still be right
query II
SELECT count(*), sum(o.oid) FROM (SELECT cid, UNNEST(orders) AS o FROM orders_tbl)
WHERE o.qty = 0 OR o.tag = 'tag2';
----
20	40222

query II
SELECT count(*), sum(o.oid) FROM (SELECT cid, UNNEST(orders) AS o FROM orders_tbl)
WHERE o.tag IN ('tag0', 'tag2');
----
37	75618

# the whole element is compared, not a field: not a field predicate
query I
SELECT o FROM (SELECT UNNEST([{'a': 1}, {'a': 2}, {'a': 3}]) AS o) WHERE o = {'a': 2};
----
{'a': 2}

# ------------------------------------------------------------------------------------------------
# corner cases where dropping elements early must not change the answer
# ------------------------------------------------------------------------------------------------

# NULL and empty lists produce no rows either way
query I
SELECT count(*) FROM (SELECT cid, UNNEST(orders) AS o FROM orders_tbl) WHERE o.qty IS NULL;
----
0

query I
SELECT count(*) FROM (SELECT cid, UNNEST(orders) AS o FROM orders_tbl) WHERE o.qty > 1000;
----
0

query I
SELECT count(*) FROM (SELECT cid, UNNEST(orders) AS o FROM orders_tbl) WHERE o.qty >= 0;
----
55

# a NULL-valued predicate drops the element, exactly like a Filter would
query I
SELECT count(*) FROM (SELECT UNNEST([{'a': 1}, {'a': NULL}, {'a': 3}]) AS o) WHERE o.a > 0;
----
2

# a child vector longer than STANDARD_VECTOR_SIZE
statement ok
CREATE TABLE wide AS SELECT i AS cid, [{'oid': i * 20 + j, 'qty': j} FOR j IN range(20)] AS orders
FROM range(3000) s(i);

query III
SELECT count(*), sum(o.oid), sum(o.qty) FROM (SELECT cid, UNNEST(orders) AS o FROM wide)
WHERE o.qty >= 17;
----
9000	270072000	162000

query II
SELECT count(*), sum(o.oid) FROM (SELECT cid, UNNEST(orders) AS o FROM wide) WHERE o.qty = 19;
----
3000	90027000

# ------------------------------------------------------------------------------------------------
# shapes a comprehension must not be formed for
# ------------------------------------------------------------------------------------------------

# references a column of the child plan as well as the element: not evaluable per element
query I
SELECT count(*) FROM (SELECT cid, UNNEST(orders) AS o FROM orders_tbl) WHERE o.qty >= cid % 3;
----
38

# two UNNESTs in one operator: can_form_comprehension is false
query II
SELECT a, b FROM (SELECT UNNEST([1, 2, 3]) AS a, UNNEST([10, 20]) AS b) WHERE a > 1 ORDER BY ALL;
----
2	20
3	NULL

# ------------------------------------------------------------------------------------------------
# the three-way classification itself, read off the plan. "Comprehension Filters" is what the
# roll-up rule left on the UNNEST, so its presence means a binder became a comprehension.
# ------------------------------------------------------------------------------------------------

statement ok
PRAGMA explain_output='OPTIMIZED_ONLY'

# a plain field predicate is a binder and forms one
query II
EXPLAIN SELECT count(*) FROM (SELECT cid, UNNEST(orders) AS o FROM orders_tbl) WHERE o.qty >= 2;
----
logical_opt	<REGEX>:.*Comprehension Filters.*

# a volatile predicate would be evaluated over a different set of values, so it does not
query II
EXPLAIN SELECT count(*) FROM (SELECT cid, UNNEST(orders) AS o FROM orders_tbl)
WHERE o.qty >= random() * 100;
----
logical_opt	<!REGEX>:.*Comprehension Filters.*

# references a column of the child plan as well as the element: not evaluable per element
query II
EXPLAIN SELECT count(*) FROM (SELECT cid, UNNEST(orders) AS o FROM orders_tbl) WHERE o.qty >= cid % 3;
----
logical_opt	<!REGEX>:.*Comprehension Filters.*

# two UNNESTs in one operator: can_form_comprehension is false
query II
EXPLAIN SELECT a FROM (SELECT UNNEST([1, 2, 3]) AS a, UNNEST([10, 20]) AS b) WHERE a > 1;
----
logical_opt	<!REGEX>:.*Comprehension Filters.*

# a passthrough is unrelated to the UNNEST and never blocks a binder next to it
query II
EXPLAIN SELECT count(*) FROM (SELECT cid, UNNEST(orders) AS o FROM orders_tbl)
WHERE o.qty >= 2 AND cid > 5;
----
logical_opt	<REGEX>:.*Comprehension Filters.*

statement ok
PRAGMA explain_output='PHYSICAL_ONLY'

# absorbing must not prune away the fields the predicate needs
query I
SELECT count(*) FROM (SELECT cid, UNNEST(orders) AS o FROM orders_tbl) WHERE o.tag = 'tag1';
----
18

query II
SELECT o.tag, count(*) FROM (SELECT cid, UNNEST(orders) AS o FROM orders_tbl)
WHERE o.qty = 2 GROUP BY o.tag ORDER BY ALL;
----
tag0	7
tag1	5
tag2	2

# ARRAY is unnested through an implicit cast to LIST
statement ok
CREATE TABLE arr AS SELECT i AS cid, [i, i + 1, i + 2]::INT[3] AS a FROM range(20) s(i);

query II
SELECT count(*), sum(e) FROM (SELECT cid, UNNEST(a) AS e FROM arr) WHERE e > 10;
----
30	466

# two-sided ranges reach the rule as BETWEEN
query II
SELECT count(*), sum(o.oid) FROM (SELECT cid, UNNEST(orders) AS o FROM orders_tbl)
WHERE o.qty >= 1 AND o.qty < 3;
----
27	51617

query II
SELECT count(*), sum(o.oid) FROM (SELECT cid, UNNEST(orders) AS o FROM orders_tbl)
WHERE o.qty BETWEEN 1 AND 2;
----
27	51617

query II
SELECT count(*), sum(o.oid) FROM (SELECT cid, UNNEST(orders) AS o FROM orders_tbl)
WHERE o.qty BETWEEN 1 AND 2 AND o.tag = 'tag0';
----
14	28500
