SELECT * FROM read_parquet_node('data/parquet-testing/arrow/repeated_no_annotation.parquet', node := 'phoneNumbers.phone') ORDER BY _sk
----
5555555555	NULL	3	3
1111111111	home	4	4
1111111111	home	5	5
2222222222	NULL	6	5
