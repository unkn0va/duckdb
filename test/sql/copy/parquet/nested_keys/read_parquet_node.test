# the non-NULL inner lists per row, rebuilt by joining the nodes
query I
SELECT list(i.inner_list ORDER BY i._sk)
FROM read_parquet_node('data/parquet-testing/arrow/nested_lists.snappy.parquet', node := 'a') o
JOIN (
	SELECT m._sk, m._ak1, list(e.element ORDER BY e._sk) AS inner_list
	FROM read_parquet_node('data/parquet-testing/arrow/nested_lists.snappy.parquet', node := 'a.element') m
	JOIN read_parquet_node('data/parquet-testing/arrow/nested_lists.snappy.parquet', node := 'a.element.element') e ON m._sk = e._ak2
	GROUP BY ALL
) i ON o._sk = i._ak1
GROUP BY o._ak0 ORDER BY o._ak0
----
[[a, b], [c], [d]]
[[a, b], [c, d], [e]]
[[a, b], [c, d], [e], [f]]

query I
SELECT list_filter(flatten(a), lambda x: x IS NOT NULL) FROM 'data/parquet-testing/arrow/nested_lists.snappy.parquet'
----
[[a, b], [c], [d]]
[[a, b], [c, d], [e]]
[[a, b], [c, d], [e], [f]]

# the levels of a row group must agree with the row counts in the metadata
statement error
SELECT * FROM read_parquet_node('data/parquet-testing/invalid_list/list_leading_repeat.parquet', node := 'l')
----
row group 0 has 2 rows on nesting level 0 according to its repetition levels, but 3 according to its metadata

# a top-level column whose values are all NULL in a row group is not read - its slots are still counted
statement ok
COPY (SELECT i, CASE WHEN i >= 4096 THEN NULL ELSE i END AS y, [i, i + 1] AS l FROM range(10000) t(i)) TO '{TEST_DIR}/all_null.parquet' (ROW_GROUP_SIZE 4096);

query I
SELECT stats_null_count FROM parquet_metadata('{TEST_DIR}/all_null.parquet') WHERE path_in_schema = 'y' ORDER BY row_group_id
----
0
4096
1808

query III
SELECT count(y), count(i), max(_sk) FROM read_parquet_node('{TEST_DIR}/all_null.parquet')
----
4096	10000	9999

query II
SELECT count(y), sum(i) FROM read_parquet_node('{TEST_DIR}/all_null.parquet')
----
4096	49995000

query II
SELECT count(*), sum(r.y) FROM read_parquet_node('{TEST_DIR}/all_null.parquet') r JOIN read_parquet_node('{TEST_DIR}/all_null.parquet', node := 'l') l ON r._sk = l._ak0
----
20000	16773120
