# name: test/sql/copy/parquet/nested_projection_unnest.test
# description: Nested projection pushdown through (nested) UNNEST only reads referenced sub-fields
# group: [parquet]

require parquet

statement ok
COPY (
    SELECT i AS id,
        [{'a': i, 'b': i * 10, 'c': i * 100}] AS posts,
        [{'title': 't' || i, 'comments': [{'author': 'au' || i, 'text': 'tx' || i}]}] AS docs
    FROM range(3) t(i)
) TO '__TEST_DIR__/nested_proj_unnest.parquet' (FORMAT parquet)

# ---- correctness ----

# single-level UNNEST, one sub-field
query I
SELECT UNNEST(posts).a AS a FROM '__TEST_DIR__/nested_proj_unnest.parquet' ORDER BY a
----
0
1
2

# single-level UNNEST, two sub-fields
query II
SELECT UNNEST(posts).a AS a, UNNEST(posts).b AS b FROM '__TEST_DIR__/nested_proj_unnest.parquet' ORDER BY a
----
0	0
1	10
2	20

# nested (two-level) UNNEST, deep sub-field
query I
SELECT UNNEST(comments).author AS author
FROM (SELECT UNNEST(docs).comments AS comments FROM '__TEST_DIR__/nested_proj_unnest.parquet')
ORDER BY author
----
au0
au1
au2

# whole element used -> full result (no pruning), still correct
query I
SELECT (UNNEST(posts)).c AS c FROM '__TEST_DIR__/nested_proj_unnest.parquet' ORDER BY c
----
0
100
200

# same list column unnested twice, where the second unnest needs 2+ sub-fields.
# regression: merging the second (multi-child) requirement used to keep only its first
# child, so posts.c was never read and came back as NULL
query III
SELECT u.a AS ua, v.b AS vb, v.c AS vc
FROM (SELECT UNNEST(posts) AS u, UNNEST(posts) AS v
      FROM '__TEST_DIR__/nested_proj_unnest.parquet')
ORDER BY ua
----
0	0	0
1	10	100
2	20	200

# same, three levels deep: the dropped requirement used to be nested under docs.comments
query III
SELECT UNNEST(d1.comments).author AS a1, UNNEST(d2.comments).text AS t2,
       UNNEST(d2.comments).author AS a2
FROM (SELECT UNNEST(docs) AS d1, UNNEST(docs) AS d2
      FROM '__TEST_DIR__/nested_proj_unnest.parquet')
ORDER BY a1
----
au0	tx0	au0
au1	tx1	au1
au2	tx2	au2

# ---- projection pushdown into the parquet scan ----

statement ok
SET explain_output='physical_only'

# single-level: only the posts.a sub-field is pushed into the scan
query II
EXPLAIN SELECT UNNEST(posts).a FROM '__TEST_DIR__/nested_proj_unnest.parquet'
----
physical_plan	<REGEX>:.*posts\.a.*

# nested: the deep sub-field path docs.comments.author is pushed all the way to the scan
query II
EXPLAIN SELECT UNNEST(comments).author FROM (SELECT UNNEST(docs).comments AS comments FROM '__TEST_DIR__/nested_proj_unnest.parquet')
----
physical_plan	<REGEX>:.*docs\.comments\.author.*

# both sub-fields of the twice-unnested column reach the scan (none dropped during merge)
query II
EXPLAIN SELECT u.a, v.b, v.c
FROM (SELECT UNNEST(posts) AS u, UNNEST(posts) AS v FROM '__TEST_DIR__/nested_proj_unnest.parquet')
----
physical_plan	<REGEX>:.*posts\.c.*

# whole element used -> no sub-field pruning (the full posts column is read, not posts.a)
query II
EXPLAIN SELECT UNNEST(posts) FROM '__TEST_DIR__/nested_proj_unnest.parquet'
----
physical_plan	<!REGEX>:.*posts\.a.*

# ---- legacy list-element schema names ----
# adam_genotypes.parquet was written by an Avro-based writer, so its LIST levels are called
# "array" rather than "list"/"element". The element level must be resolved positionally,
# otherwise the multi-file column mapper cannot descend into it.
require parquet

query I
SELECT len(variant.names) FROM '__WORKING_DIRECTORY__/data/parquet-testing/adam_genotypes.parquet'
----
1

query I
SELECT variant.names[1] FROM '__WORKING_DIRECTORY__/data/parquet-testing/adam_genotypes.parquet'
----
name

query I
SELECT len(variant.filtersFailed) FROM '__WORKING_DIRECTORY__/data/parquet-testing/adam_genotypes.parquet'
----
0

query I
SELECT variant.annotation IS NULL FROM '__WORKING_DIRECTORY__/data/parquet-testing/adam_genotypes.parquet'
----
true
